NODE_ENV=development
PORT=5199
DATABASE_URL=postgres://shards:shards_local_only@127.0.0.1:55439/shards
REDIS_URL=redis://127.0.0.1:56389/0
PUBLIC_BASE_URL=http://127.0.0.1:5198/api
PUBLIC_FRONTEND_ORIGIN=http://127.0.0.1:5198
ARCO_PAY_PROVIDER_MODE=disabled
SHARDS_CHECKOUT_ENABLED=false
SHARDS_PAYMENTS_ENABLED=false
SHARDS_FULFILLMENT_ENABLED=false
CATALOG_PUBLIC_GAMES=cs2
# Production requires unique random secrets, at least 32 characters each.
# COOKIE_HMAC_SECRET=
# DATA_ENCRYPTION_SECRET=
# Own deployment only; /api is the public backend base, frontend origin has no path.
# ARCO_PAY_API_KEY_FILE=/run/secrets/arco-pay-key
# ARCO_PAY_PUBLIC_KEY_FILE=/run/secrets/arco-pay-webhook
# ARCO_PAY_PUBLIC_ORIGIN=https://your-shards-domain.example
# SIH_API_KEY_FILE=/run/secrets/sih-market-key
# SIH_STEAM_REFILL_API_KEY_FILE=/run/secrets/sih-steam-key
# PURELYMAIL_SMTP_USERNAME=own-sender@example.test
# PURELYMAIL_SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# PURELYMAIL_SMTP_FROM=Shards <own-sender@example.test>
# VV_ADMIN_SITE_KEY=shards
# VV_ADMIN_WEBHOOK_SITE_KEY=own-shards-webhook-key
# VV_ADMIN_WEBHOOK_URL=https://your-admin.example/commerce/webhook
# VV_ADMIN_WEBHOOK_SECRET_FILE=/run/secrets/vv-admin-webhook
# ADMIN_API_TOKEN_FILE=/run/secrets/admin-api-token

# Arco Pay / Clickit shared shop. Keep secrets only in runtime configuration.
# ARCO_PAY_BEARER_TOKEN_FILE=
ARCO_PAY_SHOP_ID=1581
ARCO_PAY_API_URL=https://api.clickit.team/api/v1
ARCO_PAY_PAYMENT_ORIGIN=https://payment.paidlayer.com
# ARCO_PAY_CALLBACK_URL=https://shardsmarket.com/api/payments/webhooks/arco-pay
