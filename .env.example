# Stage: ~/.envs/shardsmarket/.env. Never commit real values.
NODE_ENV=production
POSTGRES_DB=shards
POSTGRES_USER=shards
POSTGRES_PASSWORD=
# Use postgres Docker hostname and URL-encode the password in DATABASE_URL.
DATABASE_URL=postgresql://shards:CHANGE_ME@postgres:5432/shards
REDIS_URL=redis://redis:6379/0
COOKIE_HMAC_SECRET=
DATA_ENCRYPTION_SECRET=
PUBLIC_BASE_URL=https://shardsmarket.example/api
PUBLIC_FRONTEND_ORIGIN=https://shardsmarket.example
CORS_ORIGINS=https://shardsmarket.example
SHARDS_CHECKOUT_ENABLED=false
SHARDS_PAYMENTS_ENABLED=false
SHARDS_FULFILLMENT_ENABLED=false
ARC_PAY_PROVIDER_MODE=disabled
CATALOG_PUBLIC_GAMES=cs2
CATALOG_SYNC_WORKER_INTERVAL_MS=300000
# Optional integrations; use own verified credentials and domains only.
# ARC_PAY_SECRET_KEY=
# ARC_PAY_WEBHOOK_SIGNING_SECRET=
# ARC_PAY_ENVIRONMENT=sandbox
# ARC_PAY_PUBLIC_ORIGIN=https://shardsmarket.example
# ARC_PAY_CHECKOUT_ALLOWED_ORIGINS=https://verified-checkout.example
# STEAM_WEB_API_KEY=
# SIH_API_KEY=
# SIH_STEAM_REFILL_API_KEY=
# ADMIN_API_TOKEN=
# PURELYMAIL_SMTP_HOST=smtp.purelymail.com
# PURELYMAIL_SMTP_PORT=465
# PURELYMAIL_SMTP_SECURE=true
# PURELYMAIL_SMTP_USERNAME=
# PURELYMAIL_SMTP_PASSWORD=
# PURELYMAIL_SMTP_FROM=
# SLACK_ORDERS_WEBHOOK_URL=
# VV_ADMIN_SITE_KEY=shardsmarket
# VV_ADMIN_WEBHOOK_SITE_KEY=
# VV_ADMIN_WEBHOOK_URL=
# VV_ADMIN_WEBHOOK_SECRET=
# VV_ADMIN_INTEGRATION_SECRET=
# VV-162 analytics: enable after domain and counter settings are verified.
ANALYTICS_ENABLED=false
ANALYTICS_GA_ID=G-XWF1ZMQBL1
ANALYTICS_YANDEX_ID=113586674
ANALYTICS_WEBVISOR=true
# GA4 Enhanced Measurement owns SPA page views; no manual page_view events.
