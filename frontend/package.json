{
  "name": "shards-skins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5198",
    "build": "next build --webpack",
    "start": "next start",
    "start:local": "next start --hostname 127.0.0.1 --port 5198",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "api:sync": "node scripts/sync-api.mjs",
    "api:check": "node scripts/sync-api.mjs --check",
    "test:e2e": "playwright test",
    "visual:source": "node scripts/check-designer-assets.mjs",
    "visual:compare": "node scripts/compare-visual.mjs",
    "visual:baseline": "node scripts/capture-designer-baseline.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.9.3"
  }
}
